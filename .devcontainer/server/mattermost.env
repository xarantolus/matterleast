# Settings for the local test server. Everything here is for a throwaway
# instance on the loopback; nothing is secret.
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SERVICESETTINGS_ENABLELOCALMODE=true
MM_SERVICESETTINGS_ENABLEDEVELOPER=true
MM_SERVICESETTINGS_ENABLETESTING=true
MM_SERVICESETTINGS_ALLOWEDUNTRUSTEDINTERNALCONNECTIONS=127.0.0.1 localhost 10.0.2.2
MM_SERVICESETTINGS_ENABLEINSECUREOUTGOINGCONNECTIONS=true
MM_SERVICESETTINGS_ENABLECUSTOMEMOJI=true
MM_SERVICESETTINGS_ENABLEEMOJIPICKER=true
MM_SERVICESETTINGS_ENABLELINKPREVIEWS=true
MM_SERVICESETTINGS_ENABLELATEX=true
MM_SERVICESETTINGS_ENABLEINLINELATEX=true
MM_SERVICESETTINGS_ENABLECOMMANDS=true
MM_SERVICESETTINGS_ENABLEINCOMINGWEBHOOKS=true
MM_SERVICESETTINGS_ENABLEOUTGOINGWEBHOOKS=true
MM_SERVICESETTINGS_ENABLEPOSTUSERNAMEOVERRIDE=true
MM_SERVICESETTINGS_ENABLEPOSTICONOVERRIDE=true
MM_SERVICESETTINGS_ENABLEBOTACCOUNTCREATION=true
MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS=true
MM_SERVICESETTINGS_ENABLEMULTIFACTORAUTHENTICATION=true
MM_SERVICESETTINGS_COLLAPSEDTHREADS=default_on
MM_SERVICESETTINGS_THREADAUTOFOLLOW=true
MM_SERVICESETTINGS_POSTPRIORITY=true
MM_SERVICESETTINGS_ENABLETUTORIAL=false
MM_SERVICESETTINGS_ENABLEONBOARDINGFLOW=false
MM_TEAMSETTINGS_ENABLEOPENSERVER=true
MM_TEAMSETTINGS_ENABLEUSERCREATION=true
MM_TEAMSETTINGS_MAXUSERSPERTEAM=1000
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_ENABLEPREVIEWMODEBANNER=false
MM_PLUGINSETTINGS_ENABLE=false
MM_LOGSETTINGS_ENABLEDIAGNOSTICS=false
MM_LOGSETTINGS_CONSOLELEVEL=INFO
MM_LOGSETTINGS_ENABLEFILE=false
# SSO through the fake GitLab in commands/responder.js: the browser reaches it
# via the emulator's host alias, the server via the loopback.
MM_GITLABSETTINGS_ENABLE=true
MM_GITLABSETTINGS_ID=matterleast-local
MM_GITLABSETTINGS_SECRET=matterleast-local-secret
MM_GITLABSETTINGS_SCOPE=read_user
MM_GITLABSETTINGS_AUTHENDPOINT=http://10.0.2.2:8066/oauth/authorize
MM_GITLABSETTINGS_TOKENENDPOINT=http://127.0.0.1:8066/oauth/token
MM_GITLABSETTINGS_USERAPIENDPOINT=http://127.0.0.1:8066/api/v4/user
