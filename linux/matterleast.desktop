# For a manual install: set Exec and Icon to the absolute paths. The app writes its own entry at start.
[Desktop Entry]
Type=Application
Name=Matterleast
Comment=Chat on Mattermost servers
Exec=matterleast %u
Icon=io.github.xarantolus.matterleast
Terminal=false
Categories=Network;Chat;InstantMessaging;
StartupWMClass=io.github.xarantolus.matterleast
MimeType=x-scheme-handler/mmauth;
